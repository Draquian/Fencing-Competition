rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /competitions/{code} {
      // Hay que conocer el código para leer; no se pueden listar competiciones.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      // El organizador (owner) puede cambiarlo todo; el resto solo resultados (res / br).
      allow update: if request.auth != null && (
        resource.data.owner == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['res', 'br'])
      );
      allow delete: if false;
    }
  }
}
